# ============================================
# Docker Compose Environment Configuration
# ============================================

# Database (PostgreSQL)
POSTGRES_USER=sharedeal_user
POSTGRES_PASSWORD=sharedeal_password
POSTGRES_DB=sharedeal_db
POSTGRES_PORT=5432

# Backend (NestJS)
BACKEND_PORT=3001
JWT_ACCESS_SECRET=sharedeal-access-secret-dev-change-in-production
JWT_REFRESH_SECRET=sharedeal-refresh-secret-dev-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
DEV_ADMIN_EMAIL=admin@sharedeal.vn
DEV_ADMIN_PASSWORD=Admin@123456
SEED_DB=true

# Frontend (Next.js)
FRONTEND_PORT=3000
